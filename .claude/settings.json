{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "REPO_ROOT": "${CLAUDE_PROJECT_DIR}",
    "CLAUDE_CODE_MAX_CONCURRENT_SUBAGENTS": "20",
    "CLAUDE_CODE_MAX_SUBAGENT_SPAWN_DEPTH": "3",
    "CLAUDE_CODE_DISABLE_BACKGROUND_TASKS": "0"
  },
  "permissions": {
    "allow": []
  },
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/tools/analytics/show-session-tokens.py\" --from-hook 2>/dev/null || true",
            "timeout": 5,
            "statusMessage": "◉ Token ledger"
          }
        ]
      },
      {
        "matcher": "/(dev|lint|run|review)",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/tools/runtime/suggest-next.py\" --command=\"$CLAUDE_COMMAND\" 2>/dev/null || true",
            "timeout": 5,
            "statusMessage": "Runtime suggestions check"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/tools/session/auto_start_hook.py\" || true",
            "timeout": 10,
            "statusMessage": "Session start (EP-069, opt-in)"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "cd \"$CLAUDE_PROJECT_DIR\" && python3 tools/analytics/harvest-session-tokens.py --from-hook 2>/dev/null || true",
            "timeout": 30,
            "statusMessage": "Analytics: harvest token usage (EP-013 dogfooding)"
          }
        ]
      }
    ]
  }
}
