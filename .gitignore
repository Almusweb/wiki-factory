# .gitignore — dal meta-framework, senza le righe del solo master (installer v2.45)
.pytest_cache/
.factory-upgrade-backup/

# Compression Layer side-channel (v2.14 Fase 2, PATTERN §20.10 + R.G6)
# Knowledge graph estratto da graphify-sync — view derivata, mai authoritative
# (filesystem = single source of truth, R.G1). Rebuildable da <code_path>.
.graphify-state/

# Visual oracle PNG artifacts (side-channel, not versioned)
code_quality/reports/*-visual-iter-*/
# Factory runners (generated by visual-oracle-protocol, not versioned)
.factory-runners/

# EP-007 a11y capability reports (v2.18)
code_quality/reports/*-a11y-iter-*/
code_quality/reports/_adhoc/a11y-*/

# EP-008 UX/UI capability reports + screenshots (v2.18)
# NB: <TSK>-uxui-design.{json,md} (single-pass, no iter) NON è gitignorato:
# deliverable tracciato, source of truth unico per TSK (versioning via git, ADR-020 §Rationale 8)
code_quality/reports/*-uxui-review-iter-*/
code_quality/reports/*-uxui-design-iter-*/
code_quality/reports/_adhoc/uxui-review-*/
code_quality/reports/_adhoc/uxui-design-*/

# EP-018 — FE Functional Oracle: fixture binarie (ROM/GBA/bin/iso) e trace Playwright
# Le fixture binarie sono escluse per dimensione; decommentare e adattare al proprio progetto:
# test-fixtures/*.rom
# test-fixtures/*.gba
# test-fixtures/*.bin
# **/test-fixtures/*.iso
# Trace Playwright functional oracle (EP-018)
code_quality/reports/*-functional-iter-*/trace/

# EP-009 — analytics event store (dati operativi, commit selettivo opt-in — vedi ADR-021)
analytics/events/
# EP-009 — actors map opzionale (actor_id→role, PII; gitignored opt-in se la factory
# non vuole committare la mappa actor→role — vedi ADR-023 §D). Decommenta per attivare.
# analytics/actors.yaml
# NB: NON gitignorare analytics/pricing.yaml, analytics/rates.yaml,
# analytics/reports/estimates/, analytics/reports/accuracy/ — versionati (ADR-022 §A, ADR-027 §A).

# EP-010 — stime (versionati, audit trail) e accuracy (versionati). _adhoc opzionalmente escluso.
# Le stime sono documenti immutabili rilevanti per audit (ADR-027 §A, rationale 4-5): NON
# gitignorate di default — divergenza ragionata vs analytics/events/ (dati operativi). Opt-out
# esplicito solo se la factory ha NDA cliente sulle stime (ADR-027 §A).
#   analytics/reports/estimates/   ← versionato (NON decommentare salvo NDA)
#   analytics/reports/accuracy/    ← versionato (NON decommentare salvo NDA)
# Report di stima effimeri (ad-hoc, non audit trail): opt-in escludibili. Decommenta se non
# vuoi versionare le stime esplorative in analytics/reports/_adhoc/.
# analytics/reports/_adhoc/estimate-*

# management/state/ — State file Temporal State Machine (EP-011 US-047)
# Versionati di default per audit retrospettivo (ADR-028 §A §Rationale 3).
# Per opt-out (NDA cliente o policy data residency), decommentare:
# management/state/

# EP-042 — LanceDB index (Hybrid Wiki Search, rebuilable via /wiki-search reindex)
.wiki-search/

# EP-054 — ctags symbol index side-channel (L1 Symbol Resolver, rebuilable via ctags-index.sh)
.ctags-state/

# EP-054 — LanceDB code chunk index (L2 Semantic Code Search, rebuilable via index-code.py)
.code-search/

# EP-060 Fleet Health snapshot + reports (gitignored, rebuildable)
.fleet-health/

# voice wake word samples (file WAV registrati localmente, non versionati)
voice/wake_word_samples/

# Dipendenze npm. Il root della factory ha un `package.json` (Playwright + axe-core per
# lo scan WCAG di EP-007/EP-067) ma NON deve versionarne le dipendenze: `npm i` ha
# portato dentro 1430 file e ~560.000 righe prima che qualcuno se ne accorgesse.
# `package.json` e `package-lock.json` restano tracciati: sono la dichiarazione, non il
# contenuto.
# Senza barra finale (EP-114 TSK-1077): `node_modules/` copre solo le directory, e un
# symlink `node_modules` verso il checkout principale (il modo di avere Playwright in un
# worktree) compariva come `?? node_modules`, committabile. Senza barra la regola vale a
# ogni livello, quindi copre anche apps/*/node_modules.
node_modules

# macOS
.DS_Store

# Python build artifacts (tool analytics)
__pycache__/
*.pyc

# Env file con credenziali locali (non versionare)
.env
.claude/worktrees/

# EP-064 US-251 — trial strumentato delle collisioni: log locale dell'intento di
# claim (append-only, per-macchina, mai versionato). Il trial osserva e non impone;
# rimuovere la directory non rompe nulla.
.kanban-trial/

# EP-069 US-306 — vista derivata dei gap aperti (rebuildable via gaps_open_view.py)
memory/gaps-open.md

# EP-069 US-316 — seen file dell'auto-apertura di sessione (per macchina, GC a TTL)
memory/auto-launch-seen.yaml
memory/active-sessions.yaml.tmp

# EP-070 — report PM (tools/coordinamento): uscite effimere, rigenerabili dal commit.
# Restano committabili config, storico e store analytics/coordinamento/<operatore>/da_assegnare.yaml.
deliverables/coordinamento/report-pm/

# Override per macchina di Claude Code (es. meno sub-agenti in parallelo sui PC poco potenti)
.claude/settings.local.json

# cost-alert: record locali per operatore (vedi analytics/alert-rules.yaml)
analytics/alerts/

# registro accessi della plancia (opt-in, locale): un file al giorno
analytics/plancia-accessi-*.jsonl

# output di /doc-tecnica, /doc-funzionale, /digest-settimanale: si rigenerano, non si versionano
deliverables/doc-tecnica/
deliverables/doc-funzionale/
deliverables/digest/

# EP-106 build_graph.py --out deliverables/grafo: output locale completo (kanban, raw), si rigenera
deliverables/grafo/

# EP-089 /promemoria e onboarding Day 0: stato locale per macchina
memory/promemoria-visti.yaml
memory/onboarding-visti.yaml

# Lanci Cypress (tools/cypress/run_report.py): report, JUnit e screenshot contengono dati
# dell'ambiente di test; si versiona solo esito.md
code_quality/cypress/*/run-*/*
!code_quality/cypress/*/run-*/esito.md

# db_access (EP-087): credenziali, stato e audit locali
.env.db
.db-access-state/
deliverables/db-access/
tools/db/db-targets.yaml

# log_access (EP-086): credenziali, certificati, registro reale e stato locali
.log-access-state/
tools/logs/certs/
tools/logs/log-targets.yaml

# object_storage_access: credenziali, certificati, registro reale, stato e audit locali
.env.object-storage
.object-storage-state/
deliverables/object-storage-access/
tools/object_storage/storage-targets.yaml
tools/object_storage/certs/

# Registro sessioni: locale al clone (sta sulla git common dir); questo path e' il fallback fuori da git
memory/active-sessions.yaml
memory/active-sessions.yaml.lock

# Report di /security-scan: path e finding del codice del cliente, mai versionati (EP-109 US-429)
security/reports/

# Config Playwright generate da tools/env/wsl_proxy.py playwright-config: porta locale, mai versionate (EP-113 US-441)
*.proxy.local.ts

# File di lock di Word (si creano aprendo un .docx, non vanno versionati)
~$*
