{
  "title": "proposed_pages: output di un worker di ingest",
  "type": "object",
  "required": ["source_txt", "proposed_pages", "gaps_opened", "contradictions_flagged"],
  "additionalProperties": false,
  "properties": {
    "source_txt": {"type": "string", "minLength": 1},
    "proposed_pages": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path", "type", "status", "title", "sources", "summary_3lines", "claims", "wikilinks_out"],
        "additionalProperties": false,
        "properties": {
          "path": {"type": "string", "pattern": "^wiki/[a-z]+/.+\\.md$"},
          "type": {"type": "string", "enum": ["concept", "entity", "source", "synthesis", "runbook", "incident"]},
          "status": {"type": "string", "enum": ["draft"]},
          "title": {"type": "string", "minLength": 1},
          "sources": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
          "summary_3lines": {"type": "string", "minLength": 1},
          "claims": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["text", "cite"],
              "additionalProperties": false,
              "properties": {
                "text": {"type": "string", "minLength": 1},
                "cite": {"type": "string", "pattern": "^\\[\\^src:"}
              }
            }
          },
          "wikilinks_out": {"type": "array", "items": {"type": "string"}},
          "figures_referenced": {"type": "array", "items": {"type": "string"}}
        }
      }
    },
    "gaps_opened": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["slug", "reason", "blocking"],
        "additionalProperties": false,
        "properties": {
          "slug": {"type": "string", "minLength": 1},
          "reason": {"type": "string", "minLength": 1},
          "blocking": {"type": "boolean"}
        }
      }
    },
    "contradictions_flagged": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["target_page", "summary"],
        "additionalProperties": false,
        "properties": {
          "target_page": {"type": "string", "pattern": "^wiki/"},
          "summary": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
