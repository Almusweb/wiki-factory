{
  "title": "task_package: handoff reviewer verso dev-agent",
  "type": "object",
  "required": ["tsk_id", "iter", "constraint", "actions", "report_ref", "previous_files_modified"],
  "additionalProperties": false,
  "properties": {
    "tsk_id": {"type": "string", "pattern": "TSK-[0-9]+$"},
    "iter": {"type": "integer", "minimum": 1},
    "constraint": {
      "type": "object",
      "required": ["scope", "max_diff_lines"],
      "additionalProperties": false,
      "properties": {
        "scope": {"type": "string", "minLength": 1},
        "max_diff_lines": {"type": "integer", "minimum": 1}
      }
    },
    "actions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["rule_id", "rule_ref", "file", "lines", "current_snippet", "expected_fix", "acceptance_criteria"],
        "additionalProperties": false,
        "properties": {
          "rule_id": {"type": "string", "minLength": 1},
          "rule_ref": {"type": "string", "minLength": 1},
          "file": {"type": "string", "minLength": 1},
          "lines": {"type": "array", "minItems": 2, "items": {"type": "integer", "minimum": 1}},
          "current_snippet": {"type": "string"},
          "expected_fix": {"type": "string", "minLength": 1},
          "acceptance_criteria": {"type": "string", "minLength": 1}
        }
      }
    },
    "report_ref": {"type": "string", "minLength": 1},
    "previous_files_modified": {"type": "array", "items": {"type": "string"}}
  }
}
